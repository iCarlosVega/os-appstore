# npm run local:setup creates .env.development.local with a random password.
# Keep this password consistent with DATABASE_URL. No variable interpolation.
POSTGRES_PASSWORD=REPLACE_WITH_GENERATED_PASSWORD
DATABASE_URL=postgresql://store:REPLACE_WITH_GENERATED_PASSWORD@127.0.0.1:55432/os_appstore_development

# local:* commands force these endpoints/mode and worktree-local paths.
STORE_LOCAL=1
APP_ENV=development
APP_URL=http://localhost:3000
BACKEND_URL=http://127.0.0.1:8000
API_HOST=127.0.0.1
API_PORT=8000
SQLITE_PATH=.data/local-postgres/unused.sqlite
BACKUP_DIR=.data/local-postgres/backups
TYPESAFE_MODEL=jev-1.13.0

# Optional LOCAL integration credentials. Absent values are forced empty.
# Do not copy production credentials. Paid AI remains disabled in settings.
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
OWNER_GITHUB_ID=
AUTH_SECRET=
GITHUB_TOKEN=
TYPESAFE_API_KEY=
DISCORD_WEBHOOK_URL=
BACKEND_PROXY_SECRET=

# Separate LOCAL Telegram bot. Shell/fallback Telegram values are never inherited.
# Enable with exactly 1 after migration; use positive numeric private owner/chat IDs.
TELEGRAM_ENABLED=0
TELEGRAM_BOT_TOKEN=
TELEGRAM_OWNER_USER_ID=
TELEGRAM_CHAT_ID=
