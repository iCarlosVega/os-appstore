# Shared local file; backend secrets must only be configured on FastAPI/worker in production.
APP_URL=http://localhost:3000
# Next.js server connects to FastAPI here. Never prefix this with NEXT_PUBLIC_.
BACKEND_URL=http://127.0.0.1:8000
# Generate with openssl rand -hex 32. Set the same value on Next.js and FastAPI in production.
# This authenticates forwarded client-IP headers; it does not replace owner authentication.
BACKEND_PROXY_SECRET=

# FastAPI and worker only:
APP_ENV=development
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
# Numeric GitHub user ID, not username.
OWNER_GITHUB_ID=
# Generate with openssl rand -hex 32. OAuth callback is APP_URL/api/auth/callback.
AUTH_SECRET=
GITHUB_TOKEN=
TYPESAFE_API_KEY=
TYPESAFE_MODEL=jev-1.13.0
DISCORD_WEBHOOK_URL=

# Separate opt-in Telegram worker; backend only. Use a separate bot per database.
# Enable with exactly 1 after migration. Numeric private owner/chat IDs, not usernames.
TELEGRAM_ENABLED=0
TELEGRAM_BOT_TOKEN=
TELEGRAM_OWNER_USER_ID=
TELEGRAM_CHAT_ID=

# FastAPI/worker: PostgreSQL for Vercel/Railway; blank uses .data/store.sqlite locally.
DATABASE_URL=
# Explicit persistent path required for production SQLite on a single host.
SQLITE_PATH=
BACKUP_DIR=
# Used by compose.yaml; choose a unique, long URL-safe password.
POSTGRES_PASSWORD=
