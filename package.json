{
  "name": "community-software-store",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "build": "next build --webpack",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "db:migrate": "node scripts/backend.mjs migrate",
    "jobs": "node scripts/backend.mjs worker",
    "jobs:once": "node scripts/backend.mjs worker --once",
    "backup": "node scripts/backend.mjs backup",
    "dev:web": "next dev",
    "dev:api": "node scripts/backend.mjs serve --reload",
    "start:api": "node scripts/backend.mjs serve",
    "local:setup": "node scripts/local.mjs setup",
    "local:db:up": "node scripts/local.mjs db-up",
    "local:db:down": "node scripts/local.mjs db-down",
    "local:dev": "node scripts/local.mjs dev",
    "local:jobs": "node scripts/local.mjs worker",
    "local:db:migrate": "node scripts/local.mjs migrate",
    "local:catalog:import": "node scripts/local.mjs import-catalog"
  },
  "dependencies": {
    "next": "https://registry.npmjs.org/next/-/next-16.3.7.tgz",
    "react": "https://registry.npmjs.org/react/-/react-19.2.8.tgz",
    "react-dom": "https://registry.npmjs.org/react-dom/-/react-dom-19.2.8.tgz",
    "react-markdown": "^10.1.0",
    "rehype-raw": "^7.0.0",
    "rehype-sanitize": "^6.0.0",
    "remark-gfm": "^4.0.1",
    "zod": "https://registry.npmjs.org/zod/-/zod-4.4.3.tgz"
  },
  "devDependencies": {
    "@types/node": "https://registry.npmjs.org/@types/node/-/node-26.6.3.tgz",
    "@types/react": "https://registry.npmjs.org/@types/react/-/react-19.2.17.tgz",
    "@types/react-dom": "https://registry.npmjs.org/@types/react-dom/-/react-dom-19.2.3.tgz",
    "typescript": "https://registry.npmjs.org/typescript/-/typescript-5.9.3.tgz"
  }
}
